#!/bin/sh
# A stand-in for the `claude` command, for trying a project with no model: it prints a recorded-format stream, writes
# <node>.txt for a build node and answers `done` (a reviewer: `VERDICT: PASS`). It proves the engine's wiring, it does not write
# code. Use it with   export PANGOLOOP_CLAUDE_COMMAND=<clone>/examples/toy/stub-claude STUB_LOG=<a file>
# (the same stand-in the tests use: tests/claude_stub.py).
STUB_NO_COST=1
export STUB_NO_COST
HERE=$(cd "$(dirname "$0")" && pwd)
exec python3 "$HERE/../../tests/claude_stub.py" "$@"
